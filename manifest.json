{
  "manifest_version": 3,
  "name": "ویرا | داشبورد هوشمند وبمستر",
  "version": "1.0",
  "description": "مدیریت فضاهای کاری، تسک‌ها، ابزارهای وبمستر و پورتفولیو با سینک سرور شخصی",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "system.cpu",
    "system.memory",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["js/github-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://github.com/*"],
      "js": ["js/media-download.js"],
      "run_at": "document_idle"
    }
  ]
}
